# Copier en .env et adapter. Ne jamais committer de vrais secrets.
NODE_ENV=development
APP_ENV=development            # development | test | production

# Base de données (PostgreSQL 16+)
# Rôle propriétaire : migrations uniquement.
DATABASE_OWNER_URL=postgresql://dospa_owner:dospa_owner_local_only@localhost:5432/dospa
# Rôle applicatif (sans BYPASSRLS) : utilisé par l'application. Créé par la migration initiale.
DATABASE_URL=postgresql://dospa_app:dospa_app_local_only@localhost:5432/dospa

# URL publique de l'application (vérification Origin / CSRF, liens d'e-mail)
APP_URL=http://localhost:3000

# Langue par défaut de la plateforme (fr | en | ar | so | aa)
DEFAULT_LOCALE=fr

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Chiffrement applicatif des secrets MFA (32 octets en base64). Générer : openssl rand -base64 32
APP_ENCRYPTION_KEY=

# E-mail : "log" (écrit dans apps/web/.dev-outbox) ou "smtp"
MAIL_TRANSPORT=log
SMTP_URL=smtp://localhost:1025
MAIL_FROM="DOSPA <no-reply@dospa.local>"

# Seed de démonstration (développement uniquement ; refusé si APP_ENV=production).
# Mot de passe attribué à tous les comptes fictifs. Choisir une valeur locale, ne pas la committer.
SEED_DEMO_PASSWORD=
# Secret TOTP base32 des comptes de démo privilégiés (optionnel ; généré si vide). Local uniquement.
SEED_DEMO_TOTP_SECRET=
